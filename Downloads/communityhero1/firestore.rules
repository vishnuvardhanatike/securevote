rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function: Check if the user is signed in
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function: Check if the request is from the owner of the document
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Helper function: Check if the user has an admin role in their database record
    function isAdmin() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{uid} {
      // Authenticated users can read their own profile, and admins can read any user profile
      allow read: if isOwner(uid) || isAdmin();
      
      // Only admins can create, update, or delete user records
      allow write: if isAdmin();
    }
  }
}
